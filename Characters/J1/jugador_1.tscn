[sub_resource type="GDScript" id="GDScript_54x30"]
script/source = "extends CharacterBody2D

const SPEED = 140.0


enum mov_states {
	idle,
	walk,
	run,
	jump,
	fall,
	dash,
	wall_slide
}

#CORREGIDO: mira ahora empieza con un valor para evitar que sea Nil
var mira = 1
var facing_direction := 1 # 1 = izquierda, -1 = derecha; conserva la última dirección
var current_state = 1
var attacking := false
var attack_hit_done := false
var anterior_state = 0
var current_speed = 0
#Salto variables
@onready var jump_force : int = -500
@onready var max_jump_time : float = 0.5
@onready var start_jump : float = 0.3
@onready var actual_jump_press : float = 0.0
@onready var dash_speed : int = 570
@onready var dash_duration : float = 0.41

func _physics_process(delta: float) -> void:
	if Input.is_action_just_pressed(\"Atack\") and not attacking:
		_start_attack()
		#DASHEO
	if (dashing()):
		current_speed = dash_speed
		if Input.is_action_just_pressed(\"dash\"):
			velocity.x = current_speed * mira * -1
		
	if attacking:
		velocity.x = move_toward(velocity.x, 0.0, SPEED * 8.0 * delta)
		move_and_slide()
		return
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta
		
	if velocity.y > 0:
		$AnimatedSprite2D.play(\"Fall\")
		$AnimatedSprite2D.scale.x = mira
	else:
		$AnimatedSprite2D.play(\"Jump\")
		$AnimatedSprite2D.scale.x = mira
		

	# Handle jump.
	if Input.is_action_just_released(\"Jump\") and velocity.y < 0:
		velocity.y = jump_force / 10
	if Input.is_action_just_pressed(\"Jump\") and is_on_floor():
		velocity.y = jump_force
		
	# Get the input direction and handle the movement/deceleration.
	# As good practicei, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"Left\", \"Right\")
	
	if direction > 0:
		mira = -1
		facing_direction = -1
		$AnimatedSprite2D.scale.x = -1
		
	elif direction < 0:
		mira = 1
		facing_direction = 1
		$AnimatedSprite2D.scale.x = 1
		
	if direction:
		current_speed = SPEED
		velocity.x = direction * current_speed
		if Input.is_action_pressed(\"Sprint\"):
			current_speed = SPEED * 2.7
			
		velocity.x = current_speed * direction
		if is_on_floor():
			if Input.is_action_pressed(\"Sprint\"):
				$AnimatedSprite2D.play(\"Run\")
			else:
				$AnimatedSprite2D.play(\"Walk\")

	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

		if is_on_floor():
			$AnimatedSprite2D.play(\"Idle\")
			$AnimatedSprite2D.scale.x = mira
			
	var estado_anterior_frame = current_state  # guarda el valor ANTES de recalcular

	if is_on_floor():
		if direction > 0 or direction < 0:
			if Input.is_action_pressed(\"Sprint\"):
				if anterior_state == 1:
					$AnimatedSprite2D.play(\"Run\")
				elif anterior_state == 2:
					$AnimatedSprite2D.play(\"Run\")
				current_state = 3
			else:
				current_state = 2
		else:
			current_state = 1

	# Solo actualiza anterior_state si el estado CAMBIÓ, y solo si no veníamos de Sprint (3)
	if current_state != estado_anterior_frame and estado_anterior_frame != 3:
		anterior_state = estado_anterior_frame
	
	print (\"Estado actual: \", current_state)
	print (\"Estado anterior: \", anterior_state)
	print (\"Hola\")
	

	move_and_slide()
func dashing():
	return not $Timer.is_stopped()
func start_dashing():
	$Timer.wait_time = dash_duration
	$Timer.start()
func _start_attack() -> void:
	# Bloquea el inicio de otro ataque hasta que termine la animación actual.
	attacking = true
	# Prepara la variable que puede utilizarse para controlar un golpe por ataque.
	attack_hit_done = false
	# Oculta temporalmente el sprite normal porque AttackSprite ya incluye
	# el cuerpo completo del personaje realizando el movimiento de ataque.
	$AnimatedSprite2D.visible = false
	# Hace visible el nodo que contiene los fotogramas de ataque.
	$AttackSprite.visible = true
	# Detiene cualquier reproducción anterior para que no continúe desde
	# un fotograma viejo cuando el jugador vuelve a presionar la tecla E.
	$AttackSprite.stop()
	# Fuerza que cada nuevo ataque comience exactamente en el primer fotograma.
	$AttackSprite.frame = 0
	# Se utiliza solamente AttackRight para evitar mezclar dos animaciones.
	# La variable mira conserva la última dirección aunque el jugador esté quieto:
	# mira > 0 significa que debe atacar hacia la izquierda, por lo que flip_h
	# refleja horizontalmente los mismos fotogramas como si fueran un espejo.
	# Si mira < 0, flip_h queda en false y el ataque se reproduce a la derecha.
	$AttackSprite.flip_h = mira > 0
	# Reproduce la única animación utilizada para los dos sentidos.
	$AttackSprite.play(\"AttackRight\")
	# Pausa esta función hasta que AnimatedSprite2D emita animation_finished.
	await $AttackSprite.animation_finished
	# Detiene el ataque al llegar a su último fotograma.
	$AttackSprite.stop()
	# Oculta AttackSprite para que no se quede visible después del golpe.
	$AttackSprite.visible = false
	# Vuelve a mostrar el sprite normal del jugador.
	$AnimatedSprite2D.visible = true
	# Permite que el jugador pueda iniciar el siguiente ataque.
	attacking = false
"

