#CORREGIDO: mira ahora empieza con un valor para evitar que sea Nil
var mira = 1
var facing_direction := 1 # 1 = izquierda, -1 = derecha; conserva la última dirección
var current_state = 1
var attacking := false
var attack_hit_done := false
var anterior_state = 0
var current_speed = 0
#Salto variables
@onready var jump_force : int = -500
@onready var max_jump_time : float = 0.5
@onready var start_jump : float = 0.3
@onready var actual_jump_press : float = 0.0
@onready var dash_speed : int = 320
@onready var dash_duration : int = 0.2

<<<<<<< Updated upstream
func _physics_process(delta: float) -> void:
	if Input.is_action_just_pressed(\"Atack\") and not attacking:
		_start_attack()
		#DASHEO
		
		
	if (dashing()):
		current_speed = dash_speed
	if Input.is_action_just_pressed(\"Sprint\"):
		velocity.x = current_speed * mira * -1
		start_dash()
	if attacking:
		velocity.x = move_toward(velocity.x, 0.0, SPEED * 8.0 * delta)
		move_and_slide()
		return
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta
		
	if velocity.y > 0:
		$AnimatedSprite2D.play(\"Fall\")
		$AnimatedSprite2D.scale.x = mira
	else:
		$AnimatedSprite2D.play(\"Jump\")
		$AnimatedSprite2D.scale.x = mira
		

	# Handle jump.
	if Input.is_action_just_released(\"Jump\") and velocity.y < 0:
		velocity.y = jump_force / 10
	if Input.is_action_just_pressed(\"Jump\") and is_on_floor():
		velocity.y = jump_force
		
	# Get the input direction and handle the movement/deceleration.
	# As good practicei, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"Left\", \"Right\")
	
	if direction > 0:
		mira = -1
		facing_direction = -1
		$AnimatedSprite2D.scale.x = -1
		
	elif direction < 0:
		mira = 1
		facing_direction = 1
		$AnimatedSprite2D.scale.x = 1
		
	if direction:
		current_speed = SPEED
		velocity.x = direction * current_speed
		if Input.is_action_pressed(\"Sprint\"):
			current_speed = SPEED * 2.7
			
		velocity.x = current_speed * direction
		if is_on_floor():
			if Input.is_action_pressed(\"Sprint\"):
				$AnimatedSprite2D.play(\"Run\")
			else:
				$AnimatedSprite2D.play(\"Walk\")

	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

		if is_on_floor():
			$AnimatedSprite2D.play(\"Idle\")
			$AnimatedSprite2D.scale.x = mira
			
	var estado_anterior_frame = current_state  # guarda el valor ANTES de recalcular

	if is_on_floor():
		if direction > 0 or direction < 0:
			if Input.is_action_pressed(\"Sprint\"):
				if anterior_state == 1:
					$AnimatedSprite2D.play(\"Run\")
				elif anterior_state == 2:
					$AnimatedSprite2D.play(\"Run\")
				current_state = 3
			else:
				current_state = 2
		else:
			current_state = 1

	# Solo actualiza anterior_state si el estado CAMBIÓ
	if current_state != estado_anterior_frame and estado_anterior_frame != 3:
		anterior_state = estado_anterior_frame
	
	print (\"Estado actual: \", current_state)
	print (\"Estado anterior: \", anterior_state)
	

	move_and_slide()
func dashing():
	return not $Timer.is_stopped()
func start_dash():
	$Timer.wait_time = dash_duration
	$Timer.start()
	
func _start_attack() -> void:
	attacking = true
	attack_hit_done = false
	$AnimatedSprite2D.visible = false
	$AttackSprite.visible = true
	$AttackSprite.flip_h = false
	# Usa únicamente la última dirección en la que se movió el jugador.
	if facing_direction < 0:
		$AttackSprite.play(\"AttackRight\")
	else:
		$AttackSprite.play(\"AttackLeft\")
	await $AttackSprite.animation_finished
	$AttackSprite.stop()
	$AttackSprite.visible = false
	$AnimatedSprite2D.visible = true
	attacking = false
"

